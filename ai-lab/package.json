{
  "name": "rag-agent-50-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "ingest": "node dist/cli.js ingest",
    "ask": "node --env-file-if-exists=.env dist/cli.js ask",
    "eval": "node dist/cli.js eval",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "mcp": "node dist/mcp-server.js",
    "mcp:check": "node dist/mcp-client.js",
    "agent": "node --env-file-if-exists=.env dist/cli.js agent",
    "vectors": "node --env-file-if-exists=.env dist/cli.js vectors",
    "qdrant": "node --env-file-if-exists=.env dist/qdrant.js",
    "graph": "node dist/graph.js",
    "memory": "node dist/cli.js memory",
    "agent:mcp": "node --env-file-if-exists=.env dist/mcp-agent.js",
    "agent:mcp:check": "node dist/mcp-agent-check.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "3.25.76",
    "@langchain/langgraph": "1.7.5",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/sdk-trace-node": "2.12.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "@types/node": "22.19.1"
  }
}
