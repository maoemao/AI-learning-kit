# Offline extractive mode is the default. This is NOT LLM generation.
PROVIDER=extractive
# For local inference: PROVIDER=ollama; install Ollama and pull models first.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
EMBED_MODEL=nomic-embed-text
# For cloud inference: PROVIDER=openai; create a key in your own provider account.
# Only server-side environment variables; never paste a key in the handbook or web UI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
PORT=8787
# Optional vector database. Uses a dedicated disposable learning collection.
QDRANT_URL=http://127.0.0.1:6333
